# ---- Backend (FastAPI) ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins (the Vite dev server).
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Requests per minute per client IP. Set to 0 to disable (dev/tests).
API_RATE_LIMIT=60
API_LOG_LEVEL=info
# Directory containing trained artifacts (index.json + per-task bundles).
# Defaults to ml/artifacts. Set this to retrain/target a different run.
MULTIDX_ARTIFACTS=ml/artifacts
# Set to "true" when behind a reverse proxy that sets X-Forwarded-For.
API_TRUST_PROXY=false
# Batch upload guards.
API_BATCH_MAX_ROWS=5000
API_BATCH_MAX_BYTES=10485760

# ---- Frontend (Vite) ----
# Base URL the browser uses to reach the API (must include /api proxy path
# if you reverse-proxy the frontend; see README deployment section).
VITE_API_URL=http://localhost:8000